# Run python3 scripts/bootstrap.py. Generated values stay in the ignored .env.
POSTGRES_DB=beauty_capstone
POSTGRES_PORT=55432
POSTGRES_PASSWORD=__GENERATE_ADMIN_PASSWORD__
APP_DB_PASSWORD=__GENERATE_APP_PASSWORD__
AGENT_DB_PASSWORD=__GENERATE_AGENT_PASSWORD__
RAG_READER_DB_PASSWORD=__GENERATE_RAG_READER_PASSWORD__
RAG_INGEST_DB_PASSWORD=__GENERATE_RAG_INGEST_PASSWORD__
INTERNAL_SERVICE_TOKEN=__GENERATE_INTERNAL_TOKEN__
APP_DB_JDBC_URL=jdbc:postgresql://127.0.0.1:55432/beauty_capstone
AGENT_DATABASE_URL=postgresql://agent_user:__GENERATE_AGENT_PASSWORD__@127.0.0.1:55432/beauty_capstone
RAG_DATABASE_URL=postgresql://rag_reader:__GENERATE_RAG_READER_PASSWORD__@127.0.0.1:55432/beauty_capstone
RAG_INGEST_DATABASE_URL=postgresql://rag_ingest:__GENERATE_RAG_INGEST_PASSWORD__@127.0.0.1:55432/beauty_capstone
BACKEND_BASE_URL=http://127.0.0.1:8080
AGENT_BASE_URL=http://127.0.0.1:8001
BUSINESS_MCP_URL=http://127.0.0.1:8002/mcp
RAG_MCP_URL=http://127.0.0.1:8003/mcp
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__
REDIS_CACHE_PORT=56379
# Queue profile only. Host values are for local smoke and future worker development.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=capstone
RABBITMQ_PASSWORD=__GENERATE_RABBITMQ_PASSWORD__
RABBITMQ_VHOST=capstone
JWT_SECRET=__GENERATE_JWT_SECRET__
# Server-only provider credentials. Never put these in VITE_*.
OPENAI_API_KEY=
VISION_MODEL=gpt-5.4-mini
TEXT_MODEL=gpt-5.4-mini
# Parallel model calls per review (OCR, rewrites). Lower it if the provider rate-limits.
MODEL_CONCURRENCY=4
# Maximum estimated input tokens per model call; each task also has a smaller cap.
MODEL_INPUT_TOKEN_BUDGET=12000
# 429, 5xx and connection errors are retried with backoff, then the fallback model is tried once if set.
MODEL_MAX_RETRIES=2
FALLBACK_TEXT_MODEL=
FALLBACK_VISION_MODEL=
MFDS_SERVICE_KEY=
KIPRIS_SERVICE_KEY=
# Official portal Swagger operation, credentialed response verification is still required.
MFDS_REPORT_URL=https://apis.data.go.kr/1471000/FtnltCosmRptPrdlstInfoService01/getRptPrdlstInq01
KIPRIS_WORD_SEARCH_URL=https://plus.kipris.or.kr/kipo-api/kipi/patUtiModInfoSearchSevice/getWordSearch
MFDS_GMP_URL=https://apis.data.go.kr/1471000/CsmtcsGmpStbltCompInfo/getCsmtcsGmpStbltCompInfo
MFDS_REGULATION_URL=https://apis.data.go.kr/1471000/CsmtcsReglMaterialInfoService/getCsmtcsReglMaterialInfoService
# RAG 임베딩. 비워 두면 OpenAI text-embedding-3-small(1024차원)로 하이브리드(키워드+벡터) 검색을 한다. OPENAI_API_KEY를 쓴다.
# off면 키워드 검색만 한다. 로컬 모델(예: BAAI/bge-m3)은 ingest extra(uv sync --all-packages --extra ingest)가 필요하다.
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_REVISION=

# Optional local acceptance account. Never put its generated password in Git.
DEV_ADMIN_EMAIL=master@beauty-review.local
DEV_ADMIN_PASSWORD=__GENERATE_DEV_ADMIN_PASSWORD__
LAW_OC=
# Optional. legalize-kr history uses the GitHub API (60 anonymous calls per hour). Without it the batch falls back to the Law API.
GITHUB_TOKEN=

# Test payments only. Keep secret keys on the API server.
PAYMENT_RETURN_URL=http://127.0.0.1:5173/credits
TOSS_TEST_CLIENT_KEY=
TOSS_TEST_SECRET_KEY=
# LangSmith tracing (off by default). Traces leave this machine, so model inputs and outputs stay hidden
# unless you set the HIDE flags to false for local debugging with synthetic data.
LANGSMITH_TRACING=false
LANGSMITH_API_KEY=
LANGSMITH_ENDPOINT=
LANGSMITH_PROJECT=beauty-capstone
LANGSMITH_HIDE_INPUTS=true
LANGSMITH_HIDE_OUTPUTS=true

# AI code lives in the sibling repository. Existing runtime environment values are unchanged.
AI_AGENT_DIR=../ai_agent
