# Run python3 scripts/bootstrap.py. Generated values stay in the ignored .env.
POSTGRES_DB=beauty_capstone
POSTGRES_PORT=55432
POSTGRES_PASSWORD=__GENERATE_ADMIN_PASSWORD__
APP_DB_PASSWORD=__GENERATE_APP_PASSWORD__
AGENT_DB_PASSWORD=__GENERATE_AGENT_PASSWORD__
RAG_READER_DB_PASSWORD=__GENERATE_RAG_READER_PASSWORD__
RAG_INGEST_DB_PASSWORD=__GENERATE_RAG_INGEST_PASSWORD__
INTERNAL_SERVICE_TOKEN=__GENERATE_INTERNAL_TOKEN__
APP_DB_JDBC_URL=jdbc:postgresql://127.0.0.1:55432/beauty_capstone
AGENT_DATABASE_URL=postgresql://agent_user:__GENERATE_AGENT_PASSWORD__@127.0.0.1:55432/beauty_capstone
RAG_DATABASE_URL=postgresql://rag_reader:__GENERATE_RAG_READER_PASSWORD__@127.0.0.1:55432/beauty_capstone
RAG_INGEST_DATABASE_URL=postgresql://rag_ingest:__GENERATE_RAG_INGEST_PASSWORD__@127.0.0.1:55432/beauty_capstone
BACKEND_BASE_URL=http://127.0.0.1:8080
AGENT_BASE_URL=http://127.0.0.1:8001
BUSINESS_MCP_URL=http://127.0.0.1:8002/mcp
RAG_MCP_URL=http://127.0.0.1:8003/mcp
EMBEDDING_MODEL=BAAI/bge-m3
EMBEDDING_DIMENSIONS=1024
REDIS_PASSWORD=__GENERATE_REDIS_PASSWORD__
REDIS_CACHE_PORT=56379
# Queue profile only. Host values are for local smoke and future worker development.
RABBITMQ_HOST=127.0.0.1
RABBITMQ_PORT=5672
RABBITMQ_MANAGEMENT_PORT=15672
RABBITMQ_USERNAME=capstone
RABBITMQ_PASSWORD=__GENERATE_RABBITMQ_PASSWORD__
RABBITMQ_VHOST=capstone
JWT_SECRET=__GENERATE_JWT_SECRET__
# Server-only provider credentials. Never put these in VITE_*.
OPENAI_API_KEY=
VISION_MODEL=gpt-5.4-mini
TEXT_MODEL=gpt-5.4-mini
MFDS_SERVICE_KEY=
KIPRIS_SERVICE_KEY=
# Confirm the approved MFDS operation and response mapping before setting its URL.
MFDS_REPORT_URL=
KIPRIS_WORD_SEARCH_URL=https://plus.kipris.or.kr/kipo-api/kipi/patUtiModInfoSearchSevice/getWordSearch
